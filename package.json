{
  "name": "bible",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/transclude-dev",
    "build": "transclude-build && node tools/edge-data.js",
    "start": "node --env-file-if-exists=.env node_modules/.bin/transclude-serve",
    "preview": "npm run build && npm start",
    "check": "transclude-check",
    "start:worker": "npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "node --test",
    "import:kjv": "node tools/import-kjv.js",
    "mcp": "node tools/mcp-server.js",
    "verify": "npm run crap && npm run check && npm run build",
    "crap": "node tools/crap.js",
    "notices": "node tools/notices.js"
  },
  "dependencies": {
    "@transclude/core": "^1.6.0",
    "hls.js": "^1.7.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "typescript": "^7.0",
    "vite": "^8",
    "wrangler": "4.160.1"
  }
}
