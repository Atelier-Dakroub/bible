# Local settings: copy to .env, which git leaves out.
# The secret the MCP server sends with a command to the open table
# (app/server.js, tools/mcp-server.js). Any long random string, such as:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# On Cloudflare the Worker has the same secret: npx wrangler secret put TABLE_TOKEN
TABLE_TOKEN=

# For the MCP server's table tools to reach the app on Cloudflare instead of
# npm run dev: its address, and an Access service token that the Access
# application allows (Zero Trust > Access > Service credentials).
# BIBLE_URL=https://bible.example.workers.dev
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
