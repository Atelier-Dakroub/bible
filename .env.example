# Local settings: copy to .env, which git leaves out. Every setting is
# optional: the app runs with none of them.

# The secret the MCP server sends with a command to the open table
# (app/server.js, tools/mcp-server.js). Needed only for the MCP table tools.
# Any long random string, such as:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
TABLE_TOKEN=

# Where the MCP server finds the app, if not at http://127.0.0.1:1960.
# BIBLE_URL=http://127.0.0.1:1960

# Turns the recordings on: the folder that holds them (app/data/audio.js,
# docs/recordings.md). Without it, the device's own voice reads aloud.
# BIBLE_AUDIO=audio

# The folder of the data files (app/data/load.js), if not ./app/data.
# BIBLE_DATA=app/data

# The port of the app (npm run dev, npm start), if not 1960.
# PORT=1960

# Signs cookies (transclude.config.js). Not used yet: the app has no
# accounts.
# COOKIE_SECRET=

# For the tools that make the recordings (tools/voice/generate.py,
# tools/join-verses.js); see each tool's header.
# WHISPER_MODEL=path/to/ggml-base.en.bin
# QWEN_BASE=path/to/Qwen3-TTS-12Hz-1.7B-Base
# VOICE_WORK=path/to/work
# BOOKS=GEN,EXO
